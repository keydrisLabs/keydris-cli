{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.keydris.com/runtime/v1/provider-execution-request.schema.json",
  "title": "Provider Execution Request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "request": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Z]+$"
        },
        "path": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^\\/.*"
        },
        "query": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            ]
          }
        },
        "headers": {
          "default": {},
          "type": "object",
          "properties": {
            "accept": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "if_match": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "if_none_match": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "github_api_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "connection_id",
    "resource_id",
    "request"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.keydris.com/runtime/v1/kit-session-response.schema.json",
  "title": "Kit Session Response",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kit": {
      "type": "object",
      "properties": {
        "kit_format": {
          "type": "string",
          "const": "jwt_svid"
        },
        "spiffe_id": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^spiffe:\\/\\/.*"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "kit_format",
        "spiffe_id",
        "token",
        "expires_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "kit"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.keydris.com/runtime/v1/session-usage-report.schema.json",
  "title": "Session Usage Report",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "events": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "service_tier": {
            "type": "string",
            "enum": [
              "default",
              "flex",
              "priority",
              "scale",
              "unknown"
            ]
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "cache_creation_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "cache_read_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "stop_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "request_id",
          "provider",
          "model",
          "input_tokens",
          "output_tokens",
          "cache_creation_tokens",
          "cache_read_tokens",
          "occurred_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "events"
  ],
  "additionalProperties": false
}

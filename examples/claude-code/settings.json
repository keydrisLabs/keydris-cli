{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "httpProxyPort": 15001,
      "allowedDomains": [
        "api.example.com"
      ]
    }
  },
  "env": {
    "NODE_EXTRA_CA_CERTS": "/path/to/.keydris-data/ca-bundle.crt",
    "SSL_CERT_FILE": "/path/to/.keydris-data/ca-bundle.crt",
    "CURL_CA_BUNDLE": "/path/to/.keydris-data/ca-bundle.crt",
    "GIT_SSL_CAINFO": "/path/to/.keydris-data/ca-bundle.crt",
    "REQUESTS_CA_BUNDLE": "/path/to/.keydris-data/ca-bundle.crt"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "keydris __session-start" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "keydris __session-end" }
        ]
      }
    ]
  }
}

# Keydris POC configuration. Copy to .env to override the built-in defaults.

# Control plane (issuer + broker stub) listen address.
KEYDRIS_CONTROL_ADDR=127.0.0.1:8081
# Base URL for the standard-HTTPS endpoints (/identity/sign, /agent/jwks), on
# :443 in production behind the ALB (public TLS cert, verified via system roots).
KEYDRIS_CONTROL_URL=http://127.0.0.1:8081
# Base URL for the mTLS endpoints (/agent/authorize, /agent/authorize/issue,
# /agent/authorize/{ulid}/revoke), on :8443. The CLI presents its client cert
# here; the server cert is verified against the system roots.
KEYDRIS_CONTROL_MTLS_URL=https://127.0.0.1:8443
# Optional: pin an extra CA to trust for the mTLS *server* cert. Leave unset in
# production (ALB presents a public cert). Set only for a local/self-signed
# control plane. This is NOT the client ca.crt from /identity/sign.
# KEYDRIS_MTLS_SERVER_CA=/path/to/server-ca.crt

# Data plane mode: "transparent" (Linux, iptables + SO_ORIGINAL_DST) or
# "proxyenv" (cross-platform HTTP_PROXY fallback; works on macOS/Windows).
KEYDRIS_DATAPLANE=transparent

# Proxy listen port (the iptables REDIRECT target, or the proxy-env port).
KEYDRIS_PROXY_PORT=15001

# Protected mock-backend listen address and the port egress is redirected for.
KEYDRIS_BACKEND_ADDR=127.0.0.1:8080
KEYDRIS_BACKEND_PORT=8080

# uid the proxy/daemon runs as; its own egress is exempted from redirection so
# proxy->backend traffic is not re-redirected into a loop. The daemon runs as
# root in the POC, so this is 0.
KEYDRIS_PROXY_UID=0

# The "real" upstream credential. It lives ONLY in the control plane and the
# backend, never on the client/agent side, and is injected by the proxy on the
# wire. This is the secretless property the POC must preserve.
KEYDRIS_CRED_HEADER=Authorization
KEYDRIS_CRED_VALUE=Bearer keydris-poc-upstream-secret

# --- `keydris login` identity provider ---
#
# Leave all of the below unset to use the built-in mock IdP (offline). Set them
# to run `keydris login` against a real AWS Cognito user pool: the CLI does the
# browser PKCE flow against Cognito's Hosted UI, and the control plane verifies
# the resulting ID token against the pool's JWKS before signing the client cert.
#
# Issuer (used by the control plane to fetch JWKS + validate iss/aud):
#   https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# KEYDRIS_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
#
# Cognito Hosted UI domain (the CLI's authorize/token endpoints are derived from
# it). Use either this or the explicit *_URL overrides below.
# KEYDRIS_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
# KEYDRIS_OAUTH_AUTHORIZE_URL=
# KEYDRIS_OAUTH_TOKEN_URL=
#
# App client id (also the expected ID-token aud).
# KEYDRIS_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#
# App client secret, only for a CONFIDENTIAL client. When set, the token
# exchange authenticates with HTTP Basic; leave unset for a public client. PKCE
# is still the real protection (a secret embedded in a CLI is not confidential).
# KEYDRIS_OAUTH_CLIENT_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyy
#
# Scopes (must yield an email claim) and the fixed loopback callback. The
# redirect URL must be registered VERBATIM in the app client's allowed callback
# URLs (Cognito requires an exact match, including the port).
# KEYDRIS_OAUTH_SCOPES=openid email
# KEYDRIS_OAUTH_REDIRECT_URL=http://localhost:3000/callback
